{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "personal-finance-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "pf",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/personal-finance-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [ "zone.js" ],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": [ "src/styles.css" ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "personal-finance-web:build:production"
            },
            "development": {
              "buildTarget": "personal-finance-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
